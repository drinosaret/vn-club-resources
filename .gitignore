.cl*/
.int*/
.vi*/

# Ignore root markdown files by default, whitelist specific ones
/*.md
!Readme.md
!LICENSE

# Next.js build output
.next/
/out/
/node_modules/
*.tsbuildinfo

# Environment variables. A glob rather than one line per name, so an env file added later is
# covered without anyone remembering to add it here. Templates are named back in.
.env
.env.*
!.env.example
!*.env.example

# Legacy MkDocs site (migrated to Next.js)
legacy/

# Python-related files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv*/
*.egg-info/
.pytest_cache/
pip-wheel-metadata/

# Debug/temp data files
our_*.txt
vndb_*.txt
vndb_*.json
api_response*.json
all_g323_vns.txt
stats.json

# Editor and OS files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
*.code-workspace
.vscode/
temp
drafts/
docs/plans/
docs/superpowers/
docs/

# Miscellaneous
*.log
*.bak
*.tmp
reference/
nul
temp/
public/search-index.json
public/sitemap*.xml
public/robots.txt

# Generated at deploy time (guide page dates for Docker builds)
.git-dates.json

# Tooling artifacts
.playwright-mcp/

# VNDB image cache (served via /img/ API route, don't commit)
.cache/
.cache-backup/
public/cache/

# Backend data (downloaded VNDB dumps, large files)
vndb-stats-backend/data/

# Backend environment (keep .env.example, ignore actual .env)
vndb-stats-backend/.env

# Twitter/social media session files (contain auth tokens)
*.tw_session

# Backend logs
vndb-stats-backend/log/
vndb-stats-backend/logs/
vndb-stats-backend/log_tensorboard/

# Backend benchmark generated content (keep config.yaml)
vndb-stats-backend/benchmark/checkpoints/
vndb-stats-backend/benchmark/vn_dataset/
vndb-stats-backend/benchmark/results.json
vndb-stats-backend/benchmark/comparison_report.md

# Docker local overrides
vndb-stats-backend/docker-compose.override.yml

# Production env (keep .example, ignore actual)
deploy/.env.prod

# SSL certificates (Cloudflare Origin CA)
deploy/nginx/ssl/

# Syncthing
.stignore
.stfolder/
*sync-conflict*

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage. Anchored to the repository root: both tools only ever write there,
# and an unanchored pattern would also swallow a route or module named coverage.
/coverage/
/.nyc_output/

# ESLint cache
.eslintcache

# Local development scripts (not needed in repo)
scripts/local/
scripts/backup-to-r2.sh
vndb-stats-backend/scripts/local/

# Local development tooling. Both read configuration and state that is ignored here, so
# neither does anything useful in a checkout.
scripts/autonomous.mjs
scripts/guard-no-commit.mjs

# Keys, certificates, and database dumps. A dump of a table this site writes holds what
# visitors saved, which is not ours to publish, and a key is a credential.
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.db
*.sqlite
*.sqlite3
*.sql
*.dump

# Backend cached/temp data files
vndb-stats-backend/*.json
vndb-stats-backend/*.csv
vndb-stats-backend/nul

# Output from the overnight loop and the gate: run artefacts, not source.
/logs/
gate.log
smoke.log

# Recommender evaluation output and one-off probe scripts under the backend's scripts/.
# The result files carry ids of sampled readers, so they stay local: run artefacts, not source.
vndb-stats-backend/scripts/eval_results/
vndb-stats-backend/scripts/_tmp_*.py

# Brainstorming companion scratch files
.superpowers/
